# Docker Compose root .env
# Copy to .env and fill in values before running docker compose up

# Laravel API key — generate with: php artisan key:generate --show
APP_KEY=

# Database
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=pos_db
MYSQL_USER=pos_user
MYSQL_PASSWORD=pos_secret

# Network (override for non-localhost environments, e.g. LAN IP or remote server)
APP_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
